{
    "name": "reex-api-builder",
    "version": "1.0.0",
    "description": "CLI tool for Reex API Builder - Generate TypeScript types and React Query hooks from OpenAPI specs",
    "main": "server.js",
    "bin": {
        "reex-build": "./bin/index.js"
    },
    "scripts": {
        "start": "node bin/index.js",
        "test": "node --test tests/"
    },
    "keywords": [
        "api",
        "openapi",
        "swagger",
        "typescript",
        "react-query",
        "code-generator",
        "cli",
        "rest-api",
        "hooks"
    ],
    "author": "Ezeka Emmanuel <ezekaemmanuel1710@gmail.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/EECvision/reex-api-builder.git"
    },
    "homepage": "https://github.com/EECvision/reex-api-builder#readme",
    "bugs": {
        "url": "https://github.com/EECvision/reex-api-builder/issues"
    },
    "engines": {
        "node": ">=16.0.0"
    },
    "files": [
        "bin/",
        "lib/",
        "routes/",
        "services/",
        "server.js",
        "paths.js",
        "README.md",
        "LICENSE"
    ],
    "dependencies": {
        "axios": "^1.6.0",
        "chokidar": "^3.5.3",
        "commander": "^11.0.0",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^4.18.2",
        "multer": "^1.4.5-lts.1",
        "open": "^8.4.2",
        "ts-morph": "^20.0.0"
    }
}